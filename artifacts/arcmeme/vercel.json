{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://arc-meme-tracker.onrender.com/api/$1"
    },
    {
      "src": "/(assets/.*|.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|json|webmanifest|woff2?))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
